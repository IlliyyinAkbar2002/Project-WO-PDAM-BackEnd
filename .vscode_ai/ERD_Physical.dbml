// =====================================================================
// ERD Physical — Work Order Management PDAM
// =====================================================================
// Format     : DBML (https://dbml.dbdiagram.io)
// Cara pakai : copy-paste seluruh isi file ini ke https://dbdiagram.io →
//              hasilnya muncul sebagai diagram kotak-tabel + kolom +
//              garis FK secara visual.
//
// Konvensi   :
//   - Prefiks `m_` = master data (referensi, jarang berubah).
//   - Tanpa prefiks = tabel transaksional (data operasional harian).
//   - Semua tabel punya `id bigint PK` + `created_at/updated_at`
//     kecuali disebutkan lain.
//
// Status     :
//   [EXIST]   = sudah ada di migrations (baseline yang jalan di dev).
//   [ALTER]   = tabel ada, tapi butuh kolom/index tambahan dari Q1–Q14.
//   [NEW]     = tabel baru, belum ada di migrations.
//   [DROP]    = tabel lama yang SUDAH di-drop via migration (tidak lagi di DBML).
//               Catatan historis: detail_form, detail_progress, form_workorder, form_template
//               sudah di-drop per Mei 2026 (migration drop_legacy_form_tables).
//               m_tipe_workorder, m_jenis_pengaduan, m_jenis_lokasi sudah di-drop
//               per Mei 2026 (migration drop_legacy_master_tables).
//
// Penting — hybrid state :
//   File ini MENGGABUNGKAN kondisi DB saat ini (bisa dicek di pgAdmin)
//   dengan rencana perubahan dari diskusi Q1–Q14. Tabel `[EXIST]` harus
//   match pgAdmin; tabel `[ALTER]/[NEW]/[DROP]` belum ada di pgAdmin
//   saat ini — itu target state yang mau dituju.
//
// Sumber keputusan : .cursor/ERD_Logical.md (Q1–Q14).
// Dialek DB        : PostgreSQL (JSONB, GIN index, text array).
// =====================================================================

Project pdam_workorder {
  database_type: 'PostgreSQL'
  Note: '''
    # Work Order Management — PDAM

    Physical ERD hasil keputusan Q1–Q14 + revisi pasca bimbingan Dospem
    (Apr 2026: JSONB form ditolak → diganti Class Table Inheritance).

    Satu WO mewakili satu perintah kerja. Alur:
      Pengaduan → Superadmin bikin WO + langsung pilih SPV → SPV isi form
      kategori (wo_meter/wo_jaringan/wo_infrastruktur) + assign Staff (tim) →
      Staff kerja + submit progres → SPV review (terima/revisi/tolak) →
      Manager approve final → Sistem terbitkan Laporan resmi (PDF).

    Form WO TIDAK pakai JSONB/form_template (ditolak Dospem). Form dikelompokkan
    ke 3 kategori statis: wo_meter, wo_jaringan, wo_infrastruktur (1:1 ke workorder).
    Kategori ditentukan oleh m_jenis_workorder.kategori_form.
  '''
}

// =====================================================================
// GROUP 1 — MASTER ORGANISASI & USER
// =====================================================================

Table m_departemen {
  id               bigint       [pk, increment]
  nama             varchar(255) [not null, note: 'Operasional | Pelayanan (hanya 2 row — Q11)']
  created_at       timestamp
  updated_at       timestamp

  Note: '[EXIST] Departemen = tim besar. Dipakai untuk policy Q11 (Manager hanya bisa assign WO di departemennya).'
}

Table m_jabatan {
  id               bigint       [pk, increment]
  nama             varchar(255) [not null, note: 'Kepala Departemen | Manager Senior | Manager | Supervisor | Staff Senior | Staff (sinkron dengan JabatanFactory)']
  created_at       timestamp
  updated_at       timestamp

  Note: '[EXIST] Jabatan = posisi struktural organisasi PDAM. Auth di mobile di-derive dari sini (SPV/Staff Senior/Staff). Super Admin/Manager di-derive dari m_role (permission layer), bukan m_jabatan.'
}

Table m_role {
  id               bigint       [pk, increment]
  nama             varchar(255) [not null, note: 'Super Admin | Manager | Employee']
  created_at       timestamp
  updated_at       timestamp

  Note: '[EXIST] Role untuk otorisasi API (Sanctum). SPV vs Staff dibedakan lewat m_jabatan, bukan m_role.'
}

Table m_pegawai {
  id               bigint        [pk, increment]
  nama             varchar(255)  [not null]
  nip              varchar(255)  [note: 'Diisi Super Admin setelah self-register mobile']
  tanggal_lahir    date          [not null]
  jenis_kelamin    varchar(16)   [not null, note: 'enum: Laki-laki | Perempuan']
  alamat           varchar(255)
  telepon          varchar(255)  [not null]
  departemen_id    bigint        [ref: > m_departemen.id]
  jabatan_id       bigint        [ref: > m_jabatan.id]
  created_at       timestamp
  updated_at       timestamp

  indexes {
    departemen_id
    jabatan_id
  }

  Note: '[EXIST] Identitas pegawai PDAM. 1 pegawai = 1 user (lihat users.pegawai_id).'
}

Table users {
  id               bigint        [pk, increment]
  pegawai_id       bigint        [not null, ref: - m_pegawai.id, note: '1:1 dengan m_pegawai']
  role_id          bigint        [not null, ref: > m_role.id]
  email            varchar(255)  [not null, unique]
  password         varchar(255)  [not null, note: 'bcrypt hash']
  created_at       timestamp
  updated_at       timestamp

  indexes {
    email [unique]
    role_id
  }

  Note: '[EXIST] Akun login. Auth via Laravel Sanctum (personal_access_tokens).'
}

// =====================================================================
// GROUP 2 — MASTER REFERENSI WORKORDER
// =====================================================================

Table m_jenis_workorder {
  id               bigint       [pk, increment]
  nama             varchar(255) [not null, note: 'Perbaikan Pipa, Kalibrasi Meteran, Pemeliharaan Pompa, dll (fixed SOP — Q2)']
  kategori_form    varchar(32)  [not null, note: 'Enum: meter | jaringan | infrastruktur. Menentukan tabel kategori mana yang di-INSERT saat SPV isi form. CHECK constraint di level app.']
  created_at       timestamp
  updated_at       timestamp

  indexes {
    kategori_form
  }

  Note: '''[ALTER] Jenis WO (apa yang dikerjakan) + penunjuk kategori form statis.
    Tambah kolom `kategori_form` (NEW) — backend baca kolom ini untuk tahu harus render schema wo_meter/wo_jaringan/wo_infrastruktur yang mana.
    Mapping starter 10 jenis: 3 meter + 4 jaringan + 3 infrastruktur (lihat JenisWorkorderSeeder).'''
}


Table m_location {
  id               bigint       [pk, increment]
  nama             varchar(255) [not null]
  latitude         decimal(10,7) [not null]
  longitude        decimal(10,7) [not null]
  radius_meter     integer      [not null, default: 100]
  created_at       timestamp
  updated_at       timestamp

  Note: '[EXIST] Titik lokasi dengan radius untuk geofencing presensi.'
}

Table m_status {
  id               bigint       [pk, increment]
  kode             varchar(32)  [not null, unique, note: 'slug stabil. WORKORDER-level: DITUGASKAN_KE_SPV, DITUGASKAN_KE_STAFF, IN_PROGRESS, PENGECEKAN, MENUNGGU_APPROVAL_MANAGER, SELESAI, DITOLAK_SPV, DITOLAK_MANAGER, FREEZE. PROGRESS-level: DRAFT, SUBMITTED, VERIFIED, REVISI_REQUESTED. PENGADUAN-level: DITERIMA, DITINDAK, SELESAI, DITOLAK, DUPLIKAT.']
  nama             varchar(255) [not null]
  keterangan       varchar(255) [not null]
  aktif            boolean      [not null]
  created_at       timestamp
  updated_at       timestamp

  indexes {
    kode [unique]
  }

  Note: '''[ALTER] Seed baru dibutuhkan: DITUGASKAN_KE_SPV, DITUGASKAN_KE_STAFF, REVISI_REQUESTED, DITOLAK_SPV, MENUNGGU_APPROVAL_MANAGER, DITOLAK_MANAGER.
    Seed lama yang DROP: BELUM_DISETUJUI, DISETUJUI (tidak relevan lagi karena Superadmin langsung assign SPV saat create WO — tidak ada tahap "menunggu persetujuan Manager").'''
}

Table m_tipe_progress {
  id               bigint       [pk, increment]
  kode             varchar(32)  [not null, unique, note: 'MULAI | PROGRESS | SELESAI | REVISI | DITOLAK']
  nama             varchar(255) [not null]
  created_at       timestamp
  updated_at       timestamp

  indexes {
    kode [unique]
  }

  Note: '[ALTER] Butuh seed tambahan: REVISI, DITOLAK (Q12).'
}

Table m_action {
  id               bigint       [pk, increment]
  kode             varchar(32)  [not null, unique, note: 'PENUGASAN | FREEZE | RESUME | EXTEND | APPROVE | REJECT | REVISI']
  nama             varchar(255) [not null]
  keterangan       varchar(255) [not null]
  created_at       timestamp
  updated_at       timestamp

  indexes {
    kode [unique]
  }

  Note: '[ALTER] Butuh seed tambahan: APPROVE, REJECT, REVISI (Q12–Q13).'
}

Table m_kpi {
  id               bigint       [pk, increment]
  kode             varchar(32)  [not null, unique, note: 'Slug stabil untuk dispatch Service: ON_TIME | RESPONSE_TIME | ZERO_REVISI | COMPLIANCE_FOTO']
  nama             varchar(255) [not null, note: 'Label UI, mis. "Selesai Tepat Waktu"']
  bobot            decimal(5,2) [note: 'Persen (0–100). Total semua KPI aktif = 100. Starter: ON_TIME=40, RESPONSE_TIME=30, ZERO_REVISI=20, COMPLIANCE_FOTO=10.']
  deskripsi        text         [note: 'Penjelasan formula dalam bahasa natural (untuk UI tooltip)']
  created_at       timestamp
  updated_at       timestamp

  indexes {
    kode [unique]
  }

  Note: '''[ALTER] Rename tabel `master_kpi` → `m_kpi`. Tambah kolom `kode` (untuk dispatch di KpiCalculatorService) + `deskripsi`.
    KPI = derived metric — dihitung on-the-fly dari progress_workorder, tidak disimpan sebagai tabel hasil.
    Formula ada di Laravel Service class `KpiCalculatorService` (switch ($kpi->kode) { ... }), BUKAN di DB.
    Starter 4 KPI: ON_TIME, RESPONSE_TIME, ZERO_REVISI, COMPLIANCE_FOTO.'''
}

// =====================================================================
// GROUP 3 — PENGADUAN (INPUT DARI LUAR)
// =====================================================================

Table pengaduan {
  id                    bigint       [pk, increment]
  external_id           varchar(255) [unique, note: 'ID dari API PDAM eksternal (nullable)']
  nomor_pelanggan       varchar(255) [note: 'Nomor meteran pelanggan']
  nama_pelapor          varchar(255)
  kontak_pelapor        varchar(255)
  alamat                varchar(255)
  deskripsi             text
  tanggal_lapor         timestamp    [not null]
  status_id             bigint       [not null, ref: > m_status.id, note: 'DITERIMA | DITINDAK | SELESAI | DITOLAK | DUPLIKAT']
  departemen_id         bigint       [ref: > m_departemen.id, note: 'Nullable — diisi saat dirouting ke departemen']
  duplicate_of_id       bigint       [ref: > pengaduan.id, note: 'Self-FK — kalau duplikat dari pengaduan lain']
  fetched_at            timestamp    [note: 'Audit: kapan di-fetch dari API PDAM']
  raw_payload           json         [note: 'JSONB — snapshot raw dari API PDAM untuk debug']
  created_at            timestamp
  updated_at            timestamp

  indexes {
    status_id
    external_id [unique]
    duplicate_of_id
  }

  Note: '[NEW] Laporan keluhan pelanggan. 1 pengaduan : N workorder (bisa dipecah jadi beberapa WO).'
}

// =====================================================================
// GROUP 4 — WORKORDER CORE
// =====================================================================

// ---------------------------------------------------------------------
// TABEL KATEGORI FORM (Class Table Inheritance)
// Setiap WO punya tepat 1 row di salah satu tabel berikut (1:1) —
// ditentukan oleh m_jenis_workorder.kategori_form.
// Di-INSERT oleh SPV (di Mobile) saat assign Staff — bukan oleh Superadmin
// saat create WO. Selama status WO masih DITUGASKAN_KE_SPV, row wo_* boleh
// belum ada. Wajib ada saat status transisi ke DITUGASKAN_KE_STAFF.
// ---------------------------------------------------------------------

Table wo_meter {
  id                  bigint        [pk, increment]
  workorder_id        bigint        [not null, unique, ref: - workorder.id, note: '1:1 ke workorder. UNIQUE + NOT NULL. ON DELETE CASCADE.']
  nomor_meter         varchar(64)   [not null, note: 'Nomor serial meter fisik']
  kondisi_meter_awal  varchar(255)  [note: 'Deskripsi kondisi sebelum pekerjaan (diisi SPV saat assign)']
  kondisi_meter_akhir varchar(255)  [note: 'Deskripsi kondisi setelah pekerjaan (diisi Staff/SPV di akhir)']
  hasil_kalibrasi     varchar(255)  [note: 'Hasil: Sesuai Standar | Tidak Sesuai | Perlu Penyesuaian (nullable — tidak relevan untuk Pemasangan Baru)']
  created_at          timestamp
  updated_at          timestamp

  indexes {
    workorder_id [unique]
    nomor_meter
  }

  Note: '''[NEW] Form statis untuk kategori Meter.
    Jenis WO yang masuk: Pemasangan Meter Baru, Pergantian Meter, Kalibrasi Meteran.
    Diisi oleh SPV di Mobile saat assign Staff (bukan Superadmin di Web).'''
}

Table wo_jaringan {
  id                  bigint         [pk, increment]
  workorder_id        bigint         [not null, unique, ref: - workorder.id, note: '1:1 ke workorder. UNIQUE + NOT NULL. ON DELETE CASCADE.']
  jenis_pipa          varchar(64)    [not null, note: 'PVC | HDPE | Galvanis | Besi Cor | dll']
  diameter_pipa       decimal(8,2)   [note: 'Dalam inch atau mm (satuan ditentukan di level app)']
  panjang_pipa        decimal(10,2)  [note: 'Dalam meter']
  tingkat_kerusakan   varchar(32)    [note: 'Ringan | Sedang | Berat (nullable — tidak relevan untuk Pemasangan Baru)']
  tindakan_perbaikan  text           [note: 'Narasi tindakan yang dilakukan (diisi di akhir oleh Staff/SPV)']
  hasil_inspeksi      text           [note: 'Narasi hasil inspeksi (nullable)']
  created_at          timestamp
  updated_at          timestamp

  indexes {
    workorder_id [unique]
    jenis_pipa
  }

  Note: '''[NEW] Form statis untuk kategori Jaringan (pipa & saluran).
    Jenis WO yang masuk: Perbaikan Pipa Bocor, Pemasangan Pipa Baru, Pergantian Pipa Lama, Pembersihan Saluran.
    Diisi oleh SPV di Mobile saat assign Staff.'''
}

Table wo_infrastruktur {
  id                   bigint        [pk, increment]
  workorder_id         bigint        [not null, unique, ref: - workorder.id, note: '1:1 ke workorder. UNIQUE + NOT NULL. ON DELETE CASCADE.']
  nama_aset            varchar(255)  [not null, note: 'mis. "Pompa Booster RT 05", "Reservoir Tandon Utara"']
  jenis_aset           varchar(64)   [not null, note: 'Pompa | Reservoir | IPA | Genset | Panel']
  kapasitas            varchar(64)   [note: 'mis. "500 L/menit" atau "1000 m3" (string karena satuan bervariasi)']
  kondisi_awal         text          [note: 'Narasi kondisi sebelum pemeliharaan']
  kondisi_akhir        text          [note: 'Narasi kondisi setelah pemeliharaan (diisi di akhir)']
  jadwal_pemeliharaan  date          [note: 'Jadwal pemeliharaan berikutnya (untuk maintenance terjadwal)']
  tindakan             text          [note: 'Narasi tindakan yang dilakukan']
  created_at           timestamp
  updated_at           timestamp

  indexes {
    workorder_id [unique]
    jenis_aset
    jadwal_pemeliharaan
  }

  Note: '''[NEW] Form statis untuk kategori Infrastruktur (aset fisik).
    Jenis WO yang masuk: Pemeliharaan Pompa, Pemeliharaan Reservoir, Inspeksi Rutin Aset.
    Diisi oleh SPV di Mobile saat assign Staff.'''
}

Table workorder {
  id                    bigint        [pk, increment]

  // ── Core fields ──────────────────────────────────────────────────
  nama_workorder        varchar(255)  [not null, note: 'RENAMED dari judul_pekerjaan']
  deskripsi             text          [note: 'NEW — deskripsi detail pekerjaan']

  // ── Relasi master ────────────────────────────────────────────────
  pengaduan_id          bigint        [ref: > pengaduan.id, note: 'Nullable — WO internal tanpa pengaduan (Q7)']
  departemen_id         bigint        [not null, ref: > m_departemen.id, note: 'Wajib untuk policy Q11']
  jenis_workorder_id    bigint        [not null, ref: > m_jenis_workorder.id, note: 'Menentukan kategori_form → tabel wo_meter/wo_jaringan/wo_infrastruktur']

  // ── Lokasi — teks bebas + geofencing ─────────────────────────────
  lokasi                varchar(255)  [note: 'NEW — alamat/keterangan lokasi tekstual (untuk display UI)']


  // ── Status & prioritas ───────────────────────────────────────────
  prioritas             varchar(32)   [not null, note: 'NEW — rendah | sedang | tinggi | darurat']
  status_id             bigint        [not null, ref: > m_status.id, note: 'Awal: DITUGASKAN_KE_SPV (Superadmin langsung pilih SPV saat create)']
  kpi_id                bigint        [ref: > m_kpi.id, note: 'Target KPI untuk WO ini (1 WO = 1 KPI). Nullable untuk backward-compat.']

  // ── Timeline ─────────────────────────────────────────────────────


  // ── User FKs ─────────────────────────────────────────────────────
  created_by_user_id    bigint        [ref: > users.id, note: 'Superadmin yang membuat WO']
  assigned_to           bigint        [not null, ref: > users.id, note: 'RENAMED dari pic_id — SPV yang di-assign Superadmin. SPV ini yang isi form wo_{kategori} + assign Staff.']
  approved_by_user_id   bigint        [ref: > users.id, note: 'Manager yang approve final']
  approved_at           timestamp
  approval_notes        text

  // ── Lembur ───────────────────────────────────────────────────────
  lembur_spl_id         bigint        [ref: > lembur_spl.id, note: 'Nullable — terisi kalau WO membutuhkan lembur']

  created_at            timestamp
  updated_at            timestamp

  indexes {
    status_id
    assigned_to
    departemen_id
    pengaduan_id
    jenis_workorder_id
    kpi_id
    prioritas
    (status_id, departemen_id)  [note: 'Untuk query dashboard Manager per-dept']
    (assigned_to, status_id)    [note: 'Untuk query WO Masuk SPV di mobile']
  }

  Note: '''[ALTER] Opsi B — FK penting dipertahankan + kolom baru dari target UI ditambahkan.
    RENAME : judul_pekerjaan → nama_workorder | waktu_penugasan → tanggal_mulai | pic_id → assigned_to.
    ADD    : deskripsi, lokasi (teks bebas), prioritas, tanggal_laporan, tanggal_selesai.
    KEEP   : semua FK ke master (jenis_workorder_id, departemen_id, pengaduan_id, status_id,
             kpi_id, lembur_spl_id, created_by_user_id, approved_by_user_id).
    DROP   : tipe_workorder_id (FK ke m_tipe_workorder — tabel di-drop Mei 2026),
             jenis_lokasi_id (FK ke m_jenis_lokasi — tabel di-drop Mei 2026),
             location_id + latitude/longitude (dipindah ke workorder_assignment).
    LOGIC  : lokasi (varchar) untuk display UI; lat/lng di workorder_assignment untuk geofencing presensi.
    CATATAN: petugas_id sudah di-DROP oleh TKT-07 — multi-petugas sekarang via wo_assignment_member (FK ke workorder_assignment).'''
}

// workorder_petugas — [DROP] Digantikan oleh wo_assignment_member (Mei 2026).
// Alasan: konsolidasi assignment ke workorder_assignment + wo_assignment_member.
// Histori: sebelumnya pivot multi-petugas langsung ke workorder (Q3 / TKT-07).

Table workorder_assignment {
  id              bigint       [pk, increment]
  workorder_id    bigint       [not null, unique, ref: - workorder.id, note: '1:1 ke workorder. UNIQUE + NOT NULL. ON DELETE CASCADE.']
  spv_user_id     bigint       [not null, ref: > users.id, note: 'SPV yang melakukan assign (= workorder.assigned_to saat event)']
  assigned_at     timestamp    [not null, note: 'Waktu SPV klik Tugaskan (atomic dengan insert wo_{kategori} + wo_assignment_member)']
  deskripsi     text         [note: 'Catatan opsional SPV untuk tim (mis. instruksi khusus)']
  tanggal_mulai   timestamp
  tanggal_selesai timestamp
  estimasi_selesai  timestamp
  latitude         decimal(10,7) [not null]
  longitude        decimal(10,7) [not null]
  accuracy         float         [note: 'GPS accuracy (meter)']
  location_id           bigint        [ref: > m_location.id]
  created_at      timestamp
  updated_at      timestamp

  indexes {
    workorder_id [unique]
    spv_user_id
    assigned_at
  }

  Note: '''[NEW] Event assign WO oleh SPV. 1 row per WO (1:1). Diisi di Tahap 5 bersamaan dengan wo_{kategori} + wo_assignment_member dalam satu DB transaction.
    Menjawab pertanyaan "kapan SPV melakukan assign?" secara eksplisit — sengaja denormalisasi ringan dari workorder_action(kode=PENUGASAN) supaya query list WO SPV tidak perlu JOIN audit trail.
    Anggota tim disimpan di tabel anak wo_assignment_member (1:N). PIC ditandai dengan is_pic=true.
    Future extension: kalau mau support histori reassign, tambah kolom `reassigned_from_id bigint nullable ref: > workorder_assignment.id` tanpa breaking change.'''
}

Table wo_assignment_member {
  id               bigint    [pk, increment]
  assignment_id    bigint    [not null, ref: > workorder_assignment.id, note: 'FK ke workorder_assignment. ON DELETE CASCADE.']
  user_id          bigint    [not null, ref: > users.id, note: 'Staff yang ditugaskan']
  is_pic           boolean   [not null, default: false, note: 'true = Penanggung Jawab / Koordinator Tim']
  created_at       timestamp
  updated_at       timestamp

  indexes {
    (assignment_id, user_id) [unique]
    user_id
  }

  Note: '''[NEW] Anggota tim yang ditugaskan per WO via workorder_assignment.
    Menggantikan tabel workorder_petugas (DROP). Relasi: workorder_assignment 1:N wo_assignment_member.
    Kolom is_pic=true menandai PIC/koordinator tim. Minimal 1 anggota, max tergantung prioritas WO.
    ON DELETE CASCADE dari workorder_assignment.'''
}

Table lembur_spl {
  id                bigint      [pk, increment]
  verifikator_id    bigint      [ref: > users.id]
  status_id         bigint      [not null, ref: > m_status.id]
  waktu_pengajuan   timestamp   [not null]
  waktu_verifikasi  timestamp
  alasan_ditolak    varchar(255)
  created_at        timestamp
  updated_at        timestamp

  Note: '[EXIST] Surat Perintah Lembur. Dipakai kalau WO membutuhkan lembur (workorder.lembur_spl_id terisi).'
}

// =====================================================================
// GROUP 5 — PROGRESS & DOKUMENTASI
// =====================================================================

Table progress_workorder {
  id                      bigint       [pk, increment]
  workorder_id            bigint       [not null, ref: > workorder.id]
  tipe_progress_id        bigint       [not null, ref: > m_tipe_progress.id, note: 'MULAI | PROGRESS | SELESAI | REVISI | DITOLAK']
  status_id               bigint       [ref: > m_status.id, note: 'DRAFT | SUBMITTED | VERIFIED | REVISI_REQUESTED | DITOLAK_SPV']
  submitted_by_user_id    bigint       [ref: > users.id, note: 'Siapa user yang submit (TKT-07 multi-petugas)']
  reviewed_by_user_id     bigint       [ref: > users.id, note: 'SPV yang review (Q12) — NEW']
  reviewed_at             timestamp    [note: 'Timestamp review SPV (Q12) — NEW']
  hasil_pengerjaan        text
  waktu_submit            timestamp
  "laporan_order"                 integer      [not null, note: 'Urutan progres ke-N dalam satu WO']
  alasan_penolakan        text         [note: 'Wajib kalau status REVISI_REQUESTED/DITOLAK_SPV (Q12) — NEW']
  field_to_revise         json         [note: 'JSONB — daftar field_name yang wajib direvisi Staff (Q12) — NEW']
  latitude         decimal(10,7) [not null]
  longitude        decimal(10,7) [not null]
  accuracy         float         [note: 'GPS accuracy (meter)']
  created_at              timestamp
  updated_at              timestamp

  indexes {
    (workorder_id, "laporan_order")
    status_id
    tipe_progress_id
    submitted_by_user_id
  }

  Note: '''[ALTER] Log eksekusi WO. ON DELETE CASCADE dari workorder.
    - APPEND ONLY: tidak pernah DELETE row (Q12 / BR-4). Rollback = insert row baru bertanda REVISI/DITOLAK.'''
}

Table dokumentasi_progress {
  id                       bigint       [pk, increment]
  progress_workorder_id    bigint       [not null, ref: > progress_workorder.id]
  url                      varchar(500) [note: 'Cloudinary URL — fallback storage lokal kalau offline']
  jenis                    varchar(32)  [note: 'HASIL_KERJA | LAMPIRAN_REVISI (Q12) — NEW']
  created_at               timestamp
  updated_at               timestamp

  indexes {
    progress_workorder_id
  }

  Note: '[ALTER] Foto/lampiran. ON DELETE CASCADE dari progress_workorder. Tambah kolom `jenis` untuk bedakan lampiran revisi vs foto kerja.'
}

// =====================================================================
// GROUP 6 — AUDIT TRAIL
// =====================================================================

Table workorder_action {
  id                    bigint       [pk, increment]
  workorder_id          bigint       [not null, ref: > workorder.id]
  action_id             bigint       [not null, ref: > m_action.id]
  actor_id              bigint       [ref: > users.id, note: 'Pelaku aksi (TKT-06)']
  keterangan            varchar(255)
  waktu_mulai           timestamp    [not null]
  estimasi_selesai      timestamp
  sisa_durasi_menit     integer      [note: 'Untuk FREEZE/EXTEND — berapa menit tersisa saat aksi terjadi']
  status_workorder      integer      [note: 'Snapshot status saat aksi']
  created_at            timestamp
  updated_at            timestamp

  indexes {
    workorder_id
    action_id
    actor_id
    (workorder_id, created_at) [note: 'Untuk timeline query']
  }

  Note: '[EXIST] Event-level audit trail. ON DELETE CASCADE dari workorder.'
}

// =====================================================================
// GROUP 7 — LAPORAN (OUTPUT RESMI)
// =====================================================================

Table laporan_workorder {
  id                       bigint       [pk, increment]
  workorder_id             bigint       [not null, unique, ref: - workorder.id, note: '1:1 — 1 WO = 1 laporan']
  nomor_laporan            varchar(64)  [not null, unique, note: 'Format: LAP-WO-YYYY-NNNN (sequence)']
  tanggal_terbit           timestamp    [not null, note: 'Saat Manager approve']
  ringkasan_pekerjaan      text         [not null]
  hasil_akhir_snapshot     json         [not null, note: 'JSONB — copy row dari wo_{kategori} (meter/jaringan/infrastruktur) di-flatten saat terbit. Immutable setelah laporan dibuat.']
  petugas_snapshot         json         [not null, note: 'JSONB — array of { user_id, nama, nip } saat terbit']
  catatan_spv              text
  catatan_manager          text
  pdf_url                  varchar(500) [note: 'Cloudinary URL hasil render domPDF (Q14) — nullable kalau render async belum jalan']
  issued_by_user_id        bigint       [not null, ref: > users.id, note: 'SPV yang finalisasi']
  approved_by_user_id      bigint       [not null, ref: > users.id, note: 'Manager yang approve']
  approved_at              timestamp    [not null]
  created_at               timestamp
  updated_at               timestamp

  indexes {
    workorder_id [unique]
    nomor_laporan [unique]
    approved_by_user_id
  }

  Note: '''[NEW] Dokumen resmi hasil WO (Q13). Auto-generate lewat Event Listener `IssueWorkorderReport` saat WO.status → SELESAI.
    hasil_akhir_snapshot di-populate dengan:
      SELECT row_to_json(t) FROM wo_{kategori} t WHERE workorder_id = :wo_id
    (kategori di-resolve dari workorder.jenis_workorder_id → m_jenis_workorder.kategori_form).'''
}

// =====================================================================
// GROUP 8 — PENDUKUNG (MATERIAL, PEMINJAMAN, AUTH)
// =====================================================================
// user_locations — [DROP] Mei 2026. Lokasi tracking sekarang langsung
// di progress_workorder.latitude/longitude/accuracy (validasi radius
// saat staff tekan Mulai/Selesai).

Table m_material {
  kode_material    integer       [pk, note: 'PK pakai kode manual, bukan auto-increment']
  nama             varchar(255)  [not null]
  jumlah_stok      integer       [not null]
  terpakai         integer       [not null, default: 0]
  satuan           varchar(32)   [note: 'pcs | meter | kg | liter | unit']
  kategori         varchar(64)   [note: 'Alat | Bahan | Suku Cadang']
  pegawai_id       bigint        [not null, ref: > m_pegawai.id, note: 'PIC gudang / yang bertanggungjawab']
  created_at       timestamp
  updated_at       timestamp

  Note: '[ALTER] Master material/bahan. Terhubung ke workorder via wo_peminjaman_material. Tambah kolom satuan + kategori.'
}

Table wo_peminjaman_material {
  id                bigint        [pk, increment]
  workorder_id      bigint        [not null, ref: > workorder.id, note: 'FK ke workorder. ON DELETE CASCADE.']
  material_kode     integer       [not null, ref: > m_material.kode_material, note: 'FK ke m_material.']
  jumlah_pinjam     integer       [not null]
  catatan           text          [note: 'Catatan staff saat mengajukan peminjaman']
  diajukan_oleh     bigint        [not null, ref: > users.id, note: 'Staff yang mengajukan']
  diajukan_at       timestamp     [not null]
  status            varchar(32)   [not null, default: 'DIPINJAM', note: 'DIPINJAM | DIKEMBALIKAN']
  jumlah_kembali    integer       [note: 'Diisi saat pengembalian. Nullable sebelum dikembalikan.']
  dikembalikan_at   timestamp     [note: 'Timestamp pengembalian']
  kondisi_kembali   varchar(64)   [note: 'BAIK | RUSAK | HILANG']
  created_at        timestamp
  updated_at        timestamp

  indexes {
    workorder_id
    material_kode
    status
  }

  Note: '''[NEW] Peminjaman material/aset untuk WO. Sifat opsional — hanya dibuat kalau WO membutuhkan material.
    Status sederhana: DIPINJAM saat diambil, DIKEMBALIKAN setelah WO selesai.
    Approval flow belum diimplementasi (future). Pengembalian dilakukan setelah staff menyelesaikan WO.'''
}

Table personal_access_tokens {
  id               bigint       [pk, increment]
  tokenable_type   varchar(255) [not null, note: 'Nilai selalu "App\\Models\\User" karena tokenable_id di-FK-kan ke users']
  tokenable_id     bigint       [not null, ref: > users.id, note: 'FK ke users.id — ON DELETE CASCADE (migration 2025_12_04_205457)']
  name             varchar(255) [not null]
  token            varchar(64)  [not null, unique]
  abilities        text
  last_used_at     timestamp
  expires_at       timestamp
  created_at       timestamp
  updated_at       timestamp

  indexes {
    (tokenable_type, tokenable_id)
    token [unique]
  }

  Note: '''[EXIST] Laravel Sanctum token storage.
    Project ini meng-override default Sanctum: kolom polymorphic `tokenable_id`
    dipaksa jadi hard FK ke `users.id` (cascade). Efeknya: token HANYA bisa
    ke user, tidak bisa ke model lain. Migration: 2025_12_04_205457.'''
}

Table sessions {
  id               varchar(255) [pk]
  user_id          bigint       [ref: > users.id, note: 'FK ON DELETE CASCADE (migration 2025_12_05_093645)']
  ip_address       varchar(45)
  user_agent       text
  payload          text         [not null]
  last_activity    integer      [not null]

  indexes {
    user_id
    last_activity
  }

  Note: '[EXIST] Laravel session (web). Bukan domain bisnis, tapi tetap direlasikan ke users untuk auto-cleanup saat user dihapus.'
}

Table password_resets {
  email            varchar(255) [not null, note: 'Email target reset — di-index']
  token            varchar(255) [not null]
  created_at       timestamp
  user_id          bigint       [unique, ref: - users.id, note: 'Nullable. UNIQUE + FK ditambahkan migration 2025_12_05_093655 → 1:1 ke users, ON DELETE CASCADE']

  indexes {
    email
    user_id [unique]
  }

  Note: '''[EXIST] Laravel password reset token. Tidak punya PK sintetis
    (Laravel default); identifier logical = (email, token). Kolom `user_id`
    ditambahkan project ini supaya bisa cleanup otomatis saat user dihapus.'''
}

Table failed_jobs {
  id               bigint       [pk, increment]
  uuid             varchar(255) [not null, unique]
  connection       text         [not null]
  queue            text         [not null]
  payload          text         [not null, note: 'Serialized job']
  exception        text         [not null]
  failed_at        timestamp    [not null, default: `CURRENT_TIMESTAMP`]

  indexes {
    uuid [unique]
  }

  Note: '[EXIST] Laravel queue failed jobs. Infrastruktur — tidak berelasi ke domain bisnis.'
}

// =====================================================================
// RELASI MULTI-FK (ditulis eksplisit untuk clarity)
// =====================================================================
// Catatan: DBML auto-detect Ref dari syntax [ref: > ...] di atas.
// Relasi multi-role ke `users` (workorder punya 4 FK ke users) sudah
// ter-capture di definisi kolom. Kalau dbdiagram.io render-nya rame,
// kamu bisa hide lewat tombol "Highlight" per tabel.

// =====================================================================
// CATATAN IMPLEMENTASI (untuk Nika & Geo)
// =====================================================================
// 1. TIPE DATA
//    - JSON di note = PostgreSQL JSONB (bukan JSON). Di Laravel: $table->jsonb('...').
//      Dipakai hanya di snapshot laporan + audit pengaduan (raw_payload) — BUKAN untuk
//      isian form WO (form WO pakai tabel kategori statis).
//    - timestamp = TIMESTAMP WITH TIME ZONE (timestamptz) — aman untuk user cross-TZ.
//    - text = PostgreSQL TEXT (unlimited). varchar(N) kalau ada batas bisnis.
//
// 2. FOREIGN KEY POLICY
//    - ON DELETE CASCADE: wo_assignment_member (dari workorder_assignment), progress_workorder,
//      dokumentasi_progress, workorder_action, wo_meter, wo_jaringan, wo_infrastruktur,
//      wo_peminjaman_material (semua dari parent workorder/workorder_assignment).
//    - [DROP] workorder_petugas, user_locations — sudah tidak ada.
//    - ON DELETE RESTRICT (default): semua FK ke master (m_*) & ke users.
//    - ON DELETE SET NULL: pengaduan.duplicate_of_id, workorder.pengaduan_id
//      (biar penghapusan pengaduan parent nggak kaskade ke WO).
//
// 3. INDEX TAMBAHAN (di luar FK default)
//    - GIN INDEX: pengaduan(raw_payload) — untuk query snapshot API eksternal.
//      (form_values GIN index DIBATALKAN karena JSONB form WO tidak jadi dipakai.)
//    - B-TREE INDEX di kolom tabel kategori:
//        CREATE INDEX wo_meter_nomor_meter ON wo_meter (nomor_meter);
//        CREATE INDEX wo_jaringan_jenis_pipa ON wo_jaringan (jenis_pipa);
//        CREATE INDEX wo_infrastruktur_jenis_aset ON wo_infrastruktur (jenis_aset);
//    - PARTIAL INDEX: hanya row aktif
//        CREATE INDEX workorder_active ON workorder (status_id)
//          WHERE status_id IN ( /* IN_PROGRESS, MENUNGGU_APPROVAL_MANAGER, dst */ );
//    - COMPOSITE INDEX untuk dashboard SPV mobile:
//        CREATE INDEX workorder_pic_status ON workorder (pic_id, status_id);
//
// 4. NAMING
//    - Tabel lama `master_kpi` (migration 073846) direname → `m_kpi`
//      supaya konsisten konvensi `m_*` (butuh rename migration + update Model).
//    - `workorder_action.status_workorder` tipe integer tanpa FK → bug lama (harusnya
//      FK ke m_status atau drop). Ditunda — tidak mempengaruhi scope assignment.
//
// 5. SEED WAJIB (setelah migration)
//    - m_status: TAMBAH kode DITUGASKAN_KE_SPV, DITUGASKAN_KE_STAFF, REVISI_REQUESTED,
//                DITOLAK_SPV, MENUNGGU_APPROVAL_MANAGER, DITOLAK_MANAGER.
//                DROP (opsional) kode BELUM_DISETUJUI, DISETUJUI (tidak dipakai lagi).
//    - m_tipe_progress: tambah kode REVISI, DITOLAK.
//    - m_action: tambah kode APPROVE, REJECT, REVISI.
//    - m_departemen: fix ke 2 row (Operasional, Pelayanan).
//    - m_kpi: seed 4 row starter (ON_TIME, RESPONSE_TIME, ZERO_REVISI, COMPLIANCE_FOTO).
//    - m_jenis_workorder: seed 10 row dengan kolom kategori_form (3 meter + 4 jaringan +
//                         3 infrastruktur). Lihat JenisWorkorderSeeder.
//
// 6. PEMETAAN JENIS WO → KATEGORI FORM (lookup m_jenis_workorder.kategori_form)
//    meter (3)           : Pemasangan Meter Baru | Pergantian Meter | Kalibrasi Meteran
//    jaringan (4)        : Perbaikan Pipa Bocor | Pemasangan Pipa Baru |
//                          Pergantian Pipa Lama | Pembersihan Saluran
//    infrastruktur (3)   : Pemeliharaan Pompa | Pemeliharaan Reservoir |
//                          Inspeksi Rutin Aset
